MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mandi-portal
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5000
ADMIN_EMAIL=admin@mandihariyanna.com
ADMIN_PASSWORD=Admin@1234
# Allowed CORS origin(s) — comma-separated if more than one deployed frontend
# calls this API, e.g. FRONTEND_URL=https://app.vercel.app,https://admin.example.com
FRONTEND_URL=http://localhost:5173

# Gemini API key — powers the AI counselling reports. Without it, forms still
# submit and rubric-based scores are stored, but report generation is skipped.
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama fallback — tried automatically if Gemini fails (quota/auth/network).
# Requires Ollama running locally (default http://localhost:11434) with the
# model already pulled: `ollama pull llama3.1:8b`. All optional — these are the defaults.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TIMEOUT_MS=180000
