MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mandi-portal
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5000
ADMIN_EMAIL=admin@mandihariyanna.com
ADMIN_PASSWORD=Admin@1234
# Allowed CORS origin(s) — comma-separated if more than one deployed frontend
# calls this API, e.g. FRONTEND_URL=https://app.vercel.app,https://admin.example.com
FRONTEND_URL=http://localhost:5173

# Hugging Face — the production default AI report generator (fast, cloud-hosted).
# Without it, forms still submit and rubric-based scores are stored, but
# report generation falls through to Ollama (if reachable) or the crude
# local rule-engine. Get a fine-grained token at
# huggingface.co/settings/tokens with "Make calls to Inference Providers"
# permission enabled (the "Inference" preset covers this) — a plain "Read"
# token does NOT have this permission. If HUGGINGFACE_MODEL is a gated model
# (e.g. Llama), also accept its license on the model's HF page first.
HUGGINGFACE_API_KEY=hf_your_token_here
# HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HUGGINGFACE_TIMEOUT_MS=90000

# Local Ollama — optional. Requires Ollama running on the SAME machine as this
# backend (default http://localhost:11434) with the model pulled:
# `ollama pull llama3.1:8b`. Only reachable when running the backend locally —
# not usable from a deployed backend (e.g. Render) since Ollama runs on a laptop.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TIMEOUT_MS=180000

# Explicit provider override — set to "ollama" or "huggingface" to force only
# that one provider (skipping the two-tier chain below), falling back to the
# local rule-engine if it fails. Leave unset in production: the default
# chain is Hugging Face -> Ollama -> local rule-engine.
# AI_PROVIDER=huggingface
