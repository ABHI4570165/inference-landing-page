MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mandi-portal
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5000
ADMIN_EMAIL=admin@mandihariyanna.com
ADMIN_PASSWORD=Admin@1234
# Allowed CORS origin(s) — comma-separated if more than one deployed frontend
# calls this API, e.g. FRONTEND_URL=https://app.vercel.app,https://admin.example.com
FRONTEND_URL=http://localhost:5173

# Gemini API key — powers the AI counselling reports. Without it, forms still
# submit and rubric-based scores are stored, but report generation is skipped.
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama fallback — tried automatically if Gemini fails (quota/auth/network).
# Requires Ollama running locally (default http://localhost:11434) with the
# model already pulled: `ollama pull llama3.1:8b`. All optional — these are the defaults.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TIMEOUT_MS=180000

# Hugging Face — cloud-hosted alternative to local Ollama, only used when
# explicitly selected below (never part of the automatic fallback chain).
# Get a free token at huggingface.co/settings/tokens. If HUGGINGFACE_MODEL is
# a gated model (e.g. Llama), accept its license on the model's HF page first.
# HUGGINGFACE_API_KEY=hf_your_token_here
# HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HUGGINGFACE_TIMEOUT_MS=60000

# Explicit provider selection — set to "ollama" or "huggingface" to skip
# Gemini entirely and always generate via that one model. Leave unset in
# production; the default (unset) is the normal Gemini -> Ollama -> rule-engine chain.
# AI_PROVIDER=huggingface
